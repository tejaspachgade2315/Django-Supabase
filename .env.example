# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# Supabase PostgreSQL Database
# Get these from: Supabase Dashboard > Project Settings > Database
# Django internal DB (admin/auth/sessions). Keep SQLite locally.
# DJANGO_DATABASE_URL=sqlite:///db.sqlite3

# (Optional) Direct Postgres connection string (may be blocked on some networks)
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase (HTTPS) - required for Tasks API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase table name (created via SQL in Supabase)
SUPABASE_TASKS_TABLE=tasks_task

# For local development, you can use SQLite:
# DATABASE_URL=sqlite:///db.sqlite3

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenWeatherMap API Key (free tier)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-api-key-here
